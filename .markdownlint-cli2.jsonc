{
  // Rule config lives here, not in .markdownlint.json. markdownlint-cli2
  // merges both files; rumdl (the notation contract's engine) loads the first
  // config it finds and stops, so rules left in the second file are silently
  // ignored and every disabled rule fires in CI.
  "config": {
    "MD013": false,
    "MD024": false,
    "MD036": false,
    "MD060": false,
    "MD022": false,
    "MD032": false
  },
  // CHANGELOG.md is generated by Flywheel/semantic-release in
  // conventional-changelog format, which violates several rules.
  // build/ and vendor/ hold third-party sources (gitignored, but
  // ignored here for local runs too).
  "ignores": [
    "CHANGELOG.md",
    "build/**",
    "**/build/**",
    "vendor/**",
    "node_modules/**",
    ".venv/**",
    ".claude/**"
  ]
}
